{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV"
  ],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "DIRECT_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "SIGNUP_ALLOWLIST",
    "MAIL_TRANSPORT",
    "MAIL_FROM",
    "MAIL_DIR",
    "RESEND_API_KEY",
    "CI",
    "PLAYWRIGHT_*",
    "STORAGE_DRIVER",
    "R2_ACCOUNT_ID",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "R2_BUCKET_NAME",
    "R2_ENDPOINT",
    "LOCAL_STORAGE_SECRET",
    "CRON_SECRET",
    "VERCEL",
    "VERCEL_ENV"
  ],
  "tasks": {
    "db:generate": {
      "inputs": [
        "prisma/schema.prisma",
        "prisma.config.ts"
      ],
      "outputs": [
        "src/generated/**"
      ]
    },
    "build": {
      "dependsOn": [
        "^build",
        "^db:generate",
        "typecheck"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint",
        "^db:generate",
        "db:generate"
      ]
    },
    "format": {
      "dependsOn": [
        "^format"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck",
        "^db:generate",
        "db:generate"
      ]
    },
    "test": {
      "dependsOn": [
        "^db:generate"
      ]
    },
    "test:e2e": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "dev": {
      "dependsOn": [
        "^db:generate"
      ],
      "cache": false,
      "persistent": true
    }
  }
}
