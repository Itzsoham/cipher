# Neon pooled connection (runtime queries).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Neon direct connection (Prisma migrations).
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# At least 32 random bytes, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=""
# Public origin of the app.
BETTER_AUTH_URL="http://localhost:3000"

# Comma-separated emails allowed to sign up. Empty refuses every sign-up.
SIGNUP_ALLOWLIST=""

# "file" writes messages to apps/web/.mail/*.json (dev, test, CI).
# "resend" is not wired up yet.
MAIL_TRANSPORT="file"
MAIL_FROM="Cipher <onboarding@resend.dev>"
# RESEND_API_KEY=""

# Storage (Phase 5)
STORAGE_DRIVER="local"                # "r2" in production, "local" in dev/test/CI
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""
# R2_ENDPOINT=""                      # https://<account_id>.r2.cloudflarestorage.com
# LOCAL_STORAGE_SECRET=""             # At least 32 random bytes for local presigned URLs HMAC
CRON_SECRET=""                        # Secret for /api/cron/cleanup-orphaned-files

